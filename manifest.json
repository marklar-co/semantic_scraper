{
    "manifest_version": 3,
    "name": "NativeExt",
    "short_name": "NativeExt",
    "description": "NativeExt",
    "version": "0.0.1",
    "permissions": [
        "activeTab",
        "downloads",
        "scripting",
        "nativeMessaging"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icon.png",
            "48": "icon.png",
            "128": "icon.png"
        }
    },
    "icons": {
        "16": "icon.png",
        "48": "icon.png",
        "128": "icon.png"
    }
}
